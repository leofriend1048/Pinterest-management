# Pinterest API
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token
PINTEREST_AD_ACCOUNT_ID=549755981346
PINTEREST_CONVERSION_TAG_ID=your_conversion_tag_id   # from ads.pinterest.com → Tag Manager

# Meta / Facebook API
META_ACCESS_TOKEN=your_meta_long_lived_system_user_token
META_AD_ACCOUNT_ID=act_your_ad_account_id

# Northbeam
NORTHBEAM_API_KEY=your_northbeam_api_key
NORTHBEAM_CLIENT_ID=your_northbeam_client_id

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-api03-...

# Slack  (leave SLACK_ENABLED=false until you have a real bot token)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#pinterest-automated
SLACK_ENABLED=false

# Runtime
LOG_LEVEL=INFO
DB_PATH=pinterest_buyer/state/pambs.db
SHADOW_MODE=true   # set to false only after validating in shadow for 1 week
